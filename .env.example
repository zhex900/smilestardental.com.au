# Google Places API (New) — live rating, review count, and review text
# Enable "Places API (New)" in Google Cloud Console and create an API key.
# https://developers.google.com/maps/documentation/places/web-service/get-api-key
GOOGLE_PLACES_API_KEY=
# Place ID for your business (from Maps URL or Place ID finder)
GOOGLE_PLACE_ID=

# --- Contact form (Resend) ---
# Create an API key: https://resend.com/api-keys
RESEND_API_KEY=
# Verified sender, e.g. "Smile Star Dental <noreply@mail.smilestardental.com.au>".
# For quick local testing you can use Resend's sandbox: onboarding@resend.dev
CONTACT_FROM_EMAIL=
# Address that receives contact form submissions (reply-to is set to the submitter).
CONTACT_TO_EMAIL=

# --- Google Ads (conversion tracking / remarketing) ---
# Public tag ID from Google Ads → Goals → Conversions → Tag setup.
NEXT_PUBLIC_GOOGLE_ADS_ID=AW-18259237001
# Click-to-call conversion label (full send_to value: AW-.../label).
NEXT_PUBLIC_GOOGLE_ADS_CALL_CONVERSION=AW-18259237001/WTZZCMPAhsMcEImx14JE
# Book appointment conversion label (full send_to value: AW-.../label).
NEXT_PUBLIC_GOOGLE_ADS_BOOKING_CONVERSION=AW-18259237001/UF_7CNr9gMMcEImx14JE

# --- Cloudflare Turnstile (spam protection) ---
# Create a widget: https://developers.cloudflare.com/turnstile/get-started/
# Exposed to the browser (safe to commit to public builds).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Server-side secret used to verify the challenge.
TURNSTILE_SECRET_KEY=
# Dev-only testing keys that always pass:
#   Site key:   1x00000000000000000000AA
#   Secret key: 1x0000000000000000000000000000000AA
